# Copy to .env.local and adjust for your environment.

# GraphQL API (backend-tredella). Must be running for product, category,
# search, seller, cart and account pages to render.
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:4000/graphql
NEXT_PUBLIC_GRAPHQL_WS_URL=ws://localhost:4000/graphql

# Public site origin — used for canonical URLs, sitemap.xml and robots.txt.
# NEXT_PUBLIC_SITE_URL=https://tredella.com

# ---- Production (set these in the Vercel project, not here) ----
# NEXT_PUBLIC_GRAPHQL_URL=https://backend-tredella.vercel.app/graphql
# NEXT_PUBLIC_GRAPHQL_WS_URL=wss://backend-tredella.vercel.app/graphql
# NEXT_PUBLIC_SITE_URL=https://buyer-tredella.vercel.app
#
# Subscriptions will not work on Vercel whatever this is set to — the
# backend runs as a serverless function and a WebSocket cannot survive
# one. The buyer app already falls back to polling.
